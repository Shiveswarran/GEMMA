  "vic_var": 1.0,
  "vic_cov": 0.04,
  "sig_n_proj": 128,
  "lambda_act": 1.0,
  "lambda_pri": 0.5,
  "lambda_sec": 0.5,
  "lambda_motif": 0.3,
  "n_motifs": 24,
  "motif_dummy_nodes": true,
  "epochs": 40,
  "batch_size": 256,
  "lr": 0.001,
  "weight_decay": 0.05,
  "warmup_frac": 0.05,
  "grad_clip": 1.0,
  "amp": true,
  "num_workers": 8,
  "seed": 42,
  "device": "auto",
  "out_dir": "runs",
  "run_name": "gemma_v5"
}