{
  "data_root": "data",
  "fsq_csv": "fsk_categories.csv",
  "pretrain_cities": [
    "istanbul",
    "petaling_jaya",
    "jakarta",
    "new_york",
    "kuwait_city",
    "sao_paulo"
  ],
  "eval_cities": [
    "tokyo",
    "istanbul",
    "jakarta"
  ],
  "train_splits": [
    "train"
  ],
  "min_trail_len": 2,
  "min_user_trails": 3,
  "max_diary_len": 128,
  "poi_encoder": "llm_cached",
  "poi_emb_dim": 1536,
  "poi_emb_cache": "poi_emb_cache",
  "sbert_model": "sentence-transformers/all-MiniLM-L6-v2",
  "n_time_harmonics": 6,
  "use_relative_space": true,
  "d_model": 256,
  "n_ctx_layers": 4,
  "n_pred_layers": 2,
  "n_heads": 8,
  "ffn_mult": 4,
  "dropout": 0.1,
  "ema_decay": 0.996,
  "geometry": "euclidean",
  "predictor_type": "xattn",
  "d_tower": 256,
  "nce_temp": 0.1,
  "n_hard_neg": 8,
  "lambda_nce": 1.0,
  "use_semantic_id": true,
  "sid_levels": 4,
  "sid_codebook": 512,
  "sid_cache": "sid_cache",
  "leaf_head": "ar",
  "diffusion_steps": 4,
  "adapt_beam_act": 3,
  "adapt_beam_pri": 8,
  "adapt_epochs": 5,
  "adapt_hidden": 32,
  "lambda_sid": 2.0,
  "lambda_geo": 1.0,
  "lambda_temporal": 1.0,
  "uncertainty_weighting": true,
  "uw_min_w": 0.5,
  "w_tower": 1.0,
  "w_hier": 1.0,
  "w_geo": 1.0,
  "w_temporal": 0.5,
  "w_revisit": 1.0,
  "hier_restrict_topk": 3,
  "few_shot_trails_per_user": 2,
  "few_shot_epochs": 3,
  "hist_trails": 15,
  "hist_max_tokens": 200,
  "random_backbone": false,
  "use_history": true,
  "causal_history": false,
  "few_shot_k": 3,
  "few_shot_frac": 0.0,
  "ft_epochs": 8,
  "ft_epochs_few": 15,
  "ft_lr_head": 0.002,
  "ft_lr_backbone": 0.0001,
  "ft_batch": 128,
