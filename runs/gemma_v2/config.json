{
  "data_root": "data",
  "fsq_csv": "fsk_categories.csv",
  "pretrain_cities": [
    "istanbul",
    "petaling_jaya",
    "jakarta",
    "new_york",
    "kuwait_city",
    "sao_paulo"
  ],
  "eval_cities": [
    "tokyo",
    "istanbul",
    "jakarta"
  ],
  "train_splits": [
    "train"
  ],
  "min_trail_len": 2,
  "min_user_trails": 3,
  "max_diary_len": 128,
  "poi_encoder": "llm_cached",
  "poi_emb_dim": 1536,
  "poi_emb_cache": "poi_emb_cache",
  "sbert_model": "sentence-transformers/all-MiniLM-L6-v2",
  "n_time_harmonics": 6,
  "use_relative_space": true,
  "d_model": 256,
  "n_ctx_layers": 4,
  "n_pred_layers": 2,
  "n_heads": 8,
  "ffn_mult": 4,
  "dropout": 0.1,
  "ema_decay": 0.996,
  "geometry": "euclidean",
  "d_tower": 256,
  "nce_temp": 0.1,
  "n_hard_neg": 8,
  "lambda_nce": 1.0,
  "w_tower": 1.0,
  "w_hier": 1.0,
  "w_geo": 1.0,
  "w_temporal": 0.5,
  "w_revisit": 1.0,
  "hier_restrict_topk": 3,
  "few_shot_trails_per_user": 2,
  "few_shot_epochs": 3,
  "masking": "block_future",
  "mask_ratio": 0.25,
  "mask_block_max": 8,
  "lambda_pred": 1.0,
  "lambda_reg": 1.0,
  "regularizer": "vicreg",
  "vic_var": 1.0,
  "vic_cov": 0.04,
  "sig_n_proj": 128,
  "lambda_act": 1.0,
  "lambda_pri": 0.5,
  "lambda_sec": 0.5,
  "lambda_motif": 0.3,
  "n_motifs": 24,
  "motif_dummy_nodes": true,
  "epochs": 40,
  "batch_size": 256,
  "lr": 0.001,
  "weight_decay": 0.05,
  "warmup_frac": 0.05,
  "grad_clip": 1.0,
  "amp": true,
  "num_workers": 8,
  "seed": 42,
  "device": "auto",
  "out_dir": "runs",
  "run_name": "gemma_v2"
}