{
  "data_root": "data_synth",
  "pretrain_cities": [
    "synth_a"
  ],
  "transfer_cities": [
    "synth_b",
    "synth_c"
  ],
  "min_trail_len": 2,
  "min_user_trails": 3,
  "max_user_seq_len": 128,
  "max_context_len": 64,
  "name_embedder": "hash",
  "sbert_model": "sentence-transformers/all-MiniLM-L6-v2",
  "name_emb_dim": 384,
  "cat_sbert": true,
  "n_time_harmonics": 4,
  "use_absolute_coords_in_encoder": false,
  "coord_grid_m": 500.0,
  "d_model": 64,
  "n_ctx_layers": 3,
  "n_pred_layers": 2,
  "n_heads": 4,
  "ffn_mult": 4,
  "dropout": 0.1,
  "n_roles": 8,
  "n_activities": 24,
  "activity_temp": 0.5,
  "ema_decay": 0.996,
  "mask_block_min": 1,
  "mask_block_max": 4,
  "lambda_pred": 1.0,
  "lambda_cat": 1.0,
  "lambda_act": 0.3,
  "lambda_markov": 0.1,
  "lambda_sig": 0.05,
  "lambda_cb": 0.05,
  "sig_n_proj": 128,
  "sigreg_warmup_epochs": 1,
  "epochs": 25,
  "batch_size": 32,
  "lr": 0.001,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "warmup_steps": 200,
  "seed": 42,
  "device": "cpu",
  "num_workers": 0,
  "knn_k": 50,
  "retrieval_blend": 0.5,
  "sem_blend": 0.5,
  "personal_prior": 1.0,
  "popularity_prior": 0.3,
  "few_shot_trails_per_user": 1,
  "top_k_save": 10,
  "eval_ks": [
    1,
    5,
    10
  ],
  "ndcg_ks": [
    5,
    10
  ],
  "max_eval_candidates": 0,
  "out_dir": "outputs",
  "run_name": "smoke",
  "log_every": 20,
  "save_predictions": true
}